# --- Python environments ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/

# --- OS noise ---
.DS_Store

# --- Datasets (never commit; ~595 MB, fetched from Kaggle) ---
data/
archive/
lol_dataset/

# --- Large intermediates (regenerable from the training scripts) ---
# features.npy is ~3.7 GB at float32 — regenerate it, do not commit it.
*.npy
*.npz
!captions.json

# --- Notebook / tooling scratch ---
.ipynb_checkpoints/
.pytest_cache/

# --- NOTE ---
# The four model artifacts are deliberately NOT ignored:
#   lstm_model.keras, tokenizer.json, scaler.pkl, svd.pkl
# They must be committed or Streamlit Community Cloud has nothing to load.
# Losing them is exactly what caused this rebuild.

# Comparison-run artifacts: their train_report.json / eval_report.json are kept
# as evidence, but the duplicate models are not worth ~53 MB in the repo.
scripts/_vmae_*/lstm_model.keras
scripts/_vmae_*/svd.pkl
scripts/_vmae_*/scaler.pkl

# Original project report — removed from the repo and from history.
CV_Project_Report.pdf
